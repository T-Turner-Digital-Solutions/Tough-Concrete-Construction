# Copy this file to .env.local for local development, and set the same
# variables in Netlify (Site settings -> Environment variables) for deploys.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Supabase (required for real auth/data persistence — see README "Database
# setup"). Without these, the app runs fully in demo/preview mode using the
# in-memory sample data in src/data/demoData.ts.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Netlify Functions (server-side only — never prefixed with VITE_, never
# exposed to the browser bundle)
# ---------------------------------------------------------------------------

# Optional: enables free-form natural-language chat in the AI Concierge via
# netlify/functions/ai-concierge.ts. Without it, the guided estimate wizard
# still works fully (it's pure client-side math against your pricing rules).
ANTHROPIC_API_KEY=

# Optional (future): server-side Supabase access for privileged operations
# (e.g. admin-only Netlify Functions). Service role key — server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payments (not yet integrated — see README "External integrations still
# needed"). Reserved names for when Stripe or Square is wired up.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SQUARE_ACCESS_TOKEN=
